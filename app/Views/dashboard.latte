{layout 'layouts/main.latte'}

{block title}Network activity / Immunity{/block}

{block content}

{*
   The dashboard leads with the live fleet activity feed — what the agents are
   actually doing (checks, blocks, publishes, challenges) with value at stake.
   First paint is server-rendered; the feed stays fresh via /api/v1/agents/feed.
   The stat tiles ride the existing /api/v1/network/stats poller.
*}

{var $explorer = $explorerUrl ?? 'https://sepolia.basescan.org'}

<section class="max-w-[1400px] mx-auto px-5 sm:px-7 pt-10 pb-6">

    {* ============== PAGE HEADER ============== *}
    <header class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 md:gap-8">
        <div class="min-w-0">
            <div class="flex items-center gap-3 mb-3">
                <span class="font-mono text-[10.5px] uppercase tracking-widest2 text-fg-tertiary">Base Sepolia</span>
                <span class="inline-flex h-1.5 w-1.5 rounded-full bg-immune-500 pulse-soft" aria-hidden="true"></span>
                <span class="font-mono text-[10.5px] uppercase tracking-widest2 text-immune-500">Live</span>
            </div>
            <h1 class="font-display text-[42px] sm:text-[60px] font-light tracking-tightest text-fg-primary leading-[1.0]">
                Network activity
            </h1>
            <p class="text-fg-secondary text-[14px] sm:text-[15px] mt-4 max-w-[640px] leading-[1.6]">
                What the fleet is doing right now &mdash; agents checking traffic, blocking threats,
                publishing antibodies and challenging the false ones, with bonds at stake &mdash; as it streams in.
            </p>
        </div>
        <div class="md:text-right md:shrink-0 flex flex-col md:items-end gap-2">
            <a href="/agents" class="inline-flex items-center gap-1.5 font-mono text-[10.5px] uppercase tracking-widest2 text-accent-soft hover:text-accent transition-colors">
                The fleet roster
                <svg width="11" height="11" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 9L9 3M9 3H4M9 3V8" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round"/></svg>
            </a>
            <span class="font-mono text-[10px] uppercase tracking-widest2 text-fg-dim">who's online</span>
        </div>
    </header>
</section>

{* ============== STATS BAR ============== *
   Same data source as the nav badge (/api/v1/network/stats) so the existing
   live poller keeps the values fresh without a page refresh. *}
<section class="relative bg-ink-sunken border-y border-ink-line/60">
    <div class="relative max-w-[1400px] mx-auto px-5 sm:px-7 py-6">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-y-6 md:gap-0">

            <div class="md:px-7 md:first:pl-0 md:border-r md:border-ink-line/60">
                <div class="font-mono text-[10.5px] uppercase tracking-widest2 text-fg-tertiary mb-2">Antibodies active</div>
                <div data-stat="antibodies_active" class="font-display text-[44px] font-light tracking-tighter text-fg-primary leading-none tabular-nums">-</div>
                <div class="font-mono text-[11px] text-immune-500 tabular-nums mt-3" data-delta="antibodies_active">&nbsp;</div>
            </div>

            <div class="md:px-7 md:border-r md:border-ink-line/60">
                <div class="font-mono text-[10.5px] uppercase tracking-widest2 text-fg-tertiary mb-2">Cache hits / hr</div>
                <div data-stat="cache_hits_per_hour" class="font-display text-[44px] font-light tracking-tighter text-fg-primary leading-none tabular-nums">-</div>
                <div class="font-mono text-[11px] text-immune-500 tabular-nums mt-3" data-delta="cache_hits_per_hour">&nbsp;</div>
            </div>

            <div class="md:px-7 md:border-r md:border-ink-line/60">
                <div class="font-mono text-[10.5px] uppercase tracking-widest2 text-fg-tertiary mb-2">LLM calls saved</div>
                <div data-stat="llm_calls_saved" class="font-display text-[44px] font-light tracking-tighter text-threat-300 leading-none tabular-nums">-</div>
                <div class="font-mono text-[11px] text-fg-tertiary mt-3">
                    <span class="text-immune-500" data-compute-saved="llm_calls_saved">&approx; $0</span> in compute
                </div>
            </div>

            <div class="md:px-7">
                <div class="font-mono text-[10.5px] uppercase tracking-widest2 text-fg-tertiary mb-2">Value protected</div>
                <div data-stat-money="value_protected_usd" class="font-display text-[44px] font-light tracking-tighter text-accent-soft leading-none tabular-nums">-</div>
                <div class="font-mono text-[11px] text-immune-500 tabular-nums mt-3" data-delta-money="value_protected_usd">&nbsp;</div>
            </div>

        </div>
    </div>
</section>

<section class="max-w-[1400px] mx-auto px-5 sm:px-7 pt-10 pb-16">
    {* ============== LIVE FLEET ACTIVITY FEED ============== *}
    <div>
        <header class="pb-4 border-b border-ink-line/40 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div class="flex items-center gap-3">
                <span class="inline-flex h-1.5 w-1.5 rounded-full bg-immune-500 pulse-soft" aria-hidden="true"></span>
                <span class="font-mono text-[10.5px] uppercase tracking-widest2 text-fg-tertiary">Live fleet activity</span>
                <span class="font-mono text-[10px] text-fg-dim">streaming</span>
            </div>
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[10px] text-fg-dim">
                <span class="inline-flex items-center gap-1.5"><span class="inline-flex h-1.5 w-1.5 rounded-full bg-immune-500"></span>allow</span>
                <span class="inline-flex items-center gap-1.5"><span class="inline-flex h-1.5 w-1.5 rounded-full bg-threat-300"></span>block</span>
                <span class="inline-flex items-center gap-1.5"><span class="inline-flex h-1.5 w-1.5 rounded-full bg-caution-300"></span>novel</span>
            </div>
        </header>

        <div class="mt-1">
            <table class="w-full">
                <thead class="sticky top-0 bg-ink-base/95 backdrop-blur z-10">
                    <tr class="border-b border-ink-line/40">
                        <th class="font-mono text-[9.5px] uppercase tracking-widest2 text-fg-tertiary font-normal text-left pl-5 sm:pl-7 pr-4 py-3 w-24">When</th>
                        <th class="font-mono text-[9.5px] uppercase tracking-widest2 text-fg-tertiary font-normal text-left pr-4 py-3 w-44">Agent</th>
                        <th class="font-mono text-[9.5px] uppercase tracking-widest2 text-fg-tertiary font-normal text-left pr-4 py-3 w-32">Action</th>
                        <th class="font-mono text-[9.5px] uppercase tracking-widest2 text-fg-tertiary font-normal text-left pr-5 sm:pr-7 py-3">Detail</th>
                    </tr>
                </thead>
                <tbody id="activity-body">
                {if count($activity ?? []) === 0}
                    <tr id="activity-empty">
                        <td colspan="4" class="px-7 py-10 text-center font-mono text-[11.5px] text-fg-dim">
                            No activity yet. It streams in as agents check, publish, and challenge.
                        </td>
                    </tr>
                {/if}
                {foreach $activity ?? [] as $a}
                    {var $statusTone = match((string) $a->status) {
                        'allow' => 'text-immune-500',
                        'block' => 'text-threat-300',
                        'novel' => 'text-caution-300',
                        'error' => 'text-threat-300',
                        default => 'text-accent-soft',
                    }}
                    {var $statusDot = match((string) $a->status) {
                        'allow' => 'bg-immune-500',
                        'block' => 'bg-threat-300',
                        'novel' => 'bg-caution-300',
                        'error' => 'bg-threat-300',
                        default => 'bg-accent-soft',
                    }}
                    <tr class="border-b border-ink-line/30 last:border-0 hover:bg-ink-elevated/30 transition-colors align-top">
                        <td class="pl-5 sm:pl-7 pr-4 py-2.5 font-mono text-[10.5px] text-fg-dim tabular-nums whitespace-nowrap">{format('timeago', $a->occurred_at)}</td>
                        <td class="pr-4 py-2.5 font-mono text-[11px] text-fg-secondary truncate">{$a->display_name}</td>
                        <td class="pr-4 py-2.5">
                            <span class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-widest2 {$statusTone}">
                                <span class="inline-flex h-1.5 w-1.5 rounded-full {$statusDot}"></span>{$a->action_type}
                            </span>
                        </td>
                        <td class="pr-5 sm:pr-7 py-2.5 text-[12px] text-fg-secondary leading-snug">
                            {$a->action_summary}
                            {if $a->antibody_imm_id}
                                <a href="/antibody/{$a->antibody_imm_id}" class="font-mono text-[10.5px] text-fg-dim hover:text-accent transition-colors ml-1">{$a->antibody_imm_id}</a>
                            {/if}
                        </td>
                    </tr>
                {/foreach}
                </tbody>
            </table>
        </div>
    </div>
</section>

<script>
(function () {
  // ---- Network stat tiles (shared with the nav badge poller) ----
  function fmtNumber(v) {
    if (v === null || v === undefined || v === '') return '-';
    const n = Number(v);
    return Number.isFinite(n) ? n.toLocaleString('en-US', { maximumFractionDigits: 0 }) : '-';
  }
  function fmtMoney(v) {
    if (v === null || v === undefined || v === '') return '-';
    const n = Number(v);
    return Number.isFinite(n) ? '$' + n.toLocaleString('en-US', { maximumFractionDigits: 0 }) : '-';
  }
  function fmtDelta(v, money) {
    if (v === null || v === undefined || v === '') return ' ';
    const n = Number(v);
    if (!Number.isFinite(n)) return ' ';
    const sign = n >= 0 ? '+' : '-';
    return sign + (money ? '$' : '') + Math.abs(n).toLocaleString('en-US', { maximumFractionDigits: 0 }) + ' in 1h';
  }
  function setStat(el, next) { if (el.textContent !== next) el.textContent = next; }

  function pollStats() {
    fetch('/api/v1/network/stats', { headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (data) {
        if (!data) return;
        const tiles = data.tiles || {};
        document.querySelectorAll('[data-stat]').forEach(function (el) {
          const m = el.getAttribute('data-stat');
          if (tiles[m]) setStat(el, fmtNumber(tiles[m].value));
        });
        document.querySelectorAll('[data-stat-money]').forEach(function (el) {
          const m = el.getAttribute('data-stat-money');
          if (tiles[m]) setStat(el, fmtMoney(tiles[m].value));
        });
        document.querySelectorAll('[data-delta]').forEach(function (el) {
          const m = el.getAttribute('data-delta');
          if (tiles[m]) setStat(el, fmtDelta(tiles[m].delta_1h, false));
        });
        document.querySelectorAll('[data-delta-money]').forEach(function (el) {
          const m = el.getAttribute('data-delta-money');
          if (tiles[m]) setStat(el, fmtDelta(tiles[m].delta_1h, true));
        });
        document.querySelectorAll('[data-compute-saved]').forEach(function (el) {
          const m = el.getAttribute('data-compute-saved');
          const tile = tiles[m];
          if (!tile) return;
          const n = Number(tile.value);
          if (!Number.isFinite(n) || n <= 0) { setStat(el, '≈ $0'); return; }
          const usd = n * 0.004;
          if (usd < 0.01) setStat(el, '≈ <$0.01');
          else if (usd < 1) setStat(el, '≈ $' + usd.toFixed(2));
          else setStat(el, '≈ $' + usd.toLocaleString('en-US', { maximumFractionDigits: 0 }));
        });
      })
      .catch(function () { /* next tick retries */ });
  }
  pollStats();
  setInterval(function () { if (document.visibilityState === 'visible') pollStats(); }, 4000);
})();

// ============================================================================
// Live fleet activity feed: polls /api/v1/agents/feed with a keyset cursor on
// the activity id. First tick REPLACES the server-rendered rows from the
// response so cursor and DOM agree; thereafter prepends only-new rows on top.
// Pauses when the tab is hidden.
// ============================================================================
(function () {
  const STATUS_TONE = {
    allow: ['text-immune-500', 'bg-immune-500'],
    block: ['text-threat-300', 'bg-threat-300'],
    novel: ['text-caution-300', 'bg-caution-300'],
    error: ['text-threat-300', 'bg-threat-300'],
    info:  ['text-accent-soft', 'bg-accent-soft'],
  };

  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  function ago(iso) {
    if (!iso) return '';
    // Postgres hands back "2026-06-13 17:45:41.544255+00": normalise to RFC3339.
    let s = String(iso).replace(' ', 'T').replace(/\.\d+/, '');
    s = s.replace(/([+-]\d\d)$/, '$1:00').replace(/([+-]\d\d)(\d\d)$/, '$1:$2');
    const t = Date.parse(s);
    if (!Number.isFinite(t)) return '';
    const sec = Math.max(0, Math.floor((Date.now() - t) / 1000));
    if (sec < 60) return sec + 's';
    if (sec < 3600) return Math.floor(sec / 60) + 'm';
    if (sec < 86400) return Math.floor(sec / 3600) + 'h';
    return Math.floor(sec / 86400) + 'd';
  }

  function activityRow(a) {
    const tone = STATUS_TONE[a.status] || ['text-accent-soft', 'bg-accent-soft'];
    const ab = a.antibody_imm_id
      ? '<a href="/antibody/' + esc(a.antibody_imm_id) + '" class="font-mono text-[10.5px] text-fg-dim hover:text-accent transition-colors ml-1">' + esc(a.antibody_imm_id) + '</a>'
      : '';
    const tr = document.createElement('tr');
    tr.className = 'border-b border-ink-line/30 last:border-0 hover:bg-ink-elevated/30 transition-colors align-top';
    tr.innerHTML =
      '<td class="pl-5 sm:pl-7 pr-4 py-2.5 font-mono text-[10.5px] text-fg-dim tabular-nums whitespace-nowrap">' + ago(a.occurred_at) + '</td>' +
      '<td class="pr-4 py-2.5 font-mono text-[11px] text-fg-secondary truncate">' + esc(a.display_name) + '</td>' +
      '<td class="pr-4 py-2.5"><span class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-widest2 ' + tone[0] + '">' +
        '<span class="inline-flex h-1.5 w-1.5 rounded-full ' + tone[1] + '"></span>' + esc(a.action_type) + '</span></td>' +
      '<td class="pr-5 sm:pr-7 py-2.5 text-[12px] text-fg-secondary leading-snug">' + esc(a.action_summary) + ab + '</td>';
    return tr;
  }

  let activitySince = 0;
  let firstTick = true;

  function applyActivity(rows) {
    const body = document.getElementById('activity-body');
    if (!body || !Array.isArray(rows)) return;
    if (firstTick) {
      if (rows.length) {
        body.innerHTML = '';                       // rows arrive newest-first
        rows.forEach(function (a) { body.appendChild(activityRow(a)); });
      }
      return;
    }
    if (!rows.length) return;
    const empty = document.getElementById('activity-empty');
    if (empty) empty.remove();
    rows.slice().reverse().forEach(function (a) {  // prepend so newest ends on top
      body.insertBefore(activityRow(a), body.firstChild);
    });
    while (body.children.length > 120) body.removeChild(body.lastChild);
  }

  function tick() {
    fetch('/api/v1/agents/feed?activity_since=' + activitySince, { headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (data) {
        if (!data) return;
        applyActivity(data.activity);
        if (typeof data.next_activity_since === 'number') activitySince = data.next_activity_since;
        firstTick = false;
      })
      .catch(function () { /* keep polling */ });
  }

  tick();
  setInterval(function () { if (document.visibilityState === 'visible') tick(); }, 4000);
})();
</script>

{/block}
