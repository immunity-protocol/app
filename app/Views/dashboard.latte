{layout 'layouts/main.latte'}

{block title}Network activity / Immunity{/block}

{block content}

{*
   Each event_name is a "Contract.Event" key mapped to a human label + colour
   tone; $eventMeta is reused per-row in the feed below. Purely presentational,
   kept in-template (no new PHP view model).
*}
{var $eventMeta = [
    'Registry.Published'                       => ['Published',      'text-accent-soft',  'bg-accent-soft'],
    'Registry.Matured'                         => ['Matured',        'text-immune-500',   'bg-immune-500'],
    'Registry.Expired'                         => ['Expired',        'text-fg-tertiary',  'bg-fg-dim'],
    'Registry.Retired'                         => ['Retired',        'text-fg-tertiary',  'bg-fg-dim'],
    'Registry.Slashed'                         => ['Slashed',        'text-threat-300',   'bg-threat-300'],
    'Registry.ChallengeOpened'                 => ['Challenged',     'text-caution-300',  'bg-caution-300'],
    'ChallengeManager.VerdictRequested'        => ['Challenge open', 'text-caution-300',  'bg-caution-300'],
    'ChallengeManager.Escalated'               => ['Escalated',      'text-caution-500',  'bg-caution-500'],
    'ChallengeManager.Resolved'                => ['Resolved',       'text-immune-300',   'bg-immune-300'],
    'CREVerdictReceiver.VerdictReceived'       => ['Jury verdict',   'text-immune-300',   'bg-immune-300'],
    'Registry.Matched'                         => ['Check blocked',  'text-threat-300',   'bg-threat-300'],
    'Registry.Checked'                         => ['Check allowed',  'text-immune-500',   'bg-immune-500'],
    'NovelVerification.VerificationRequested'  => ['CRE requested',  'text-accent-soft',  'bg-accent-soft'],
    'NovelVerification.Verified'               => ['CRE verdict',    'text-caution-300',  'bg-caution-300'],
    'Reputation.Matured'                       => ['Rep +matured',   'text-immune-500',   'bg-immune-500'],
    'Reputation.ChallengeWon'                  => ['Rep +won',       'text-immune-500',   'bg-immune-500'],
    'Reputation.Slashed'                       => ['Rep slashed',    'text-threat-300',   'bg-threat-300'],
    'Reputation.GenesisGranted'                => ['Rep genesis',    'text-accent-soft',  'bg-accent-soft'],
    'Registry.BondLocked'                      => ['Bond locked',    'text-fg-secondary', 'bg-fg-tertiary'],
    'Registry.BondReleased'                    => ['Bond released',  'text-fg-secondary', 'bg-fg-tertiary'],
    'ProtectedSet.ProtectedUpdated'            => ['Protected set',  'text-immune-300',   'bg-immune-300'],
]}

{var $explorer = $explorerUrl ?? 'https://sepolia.basescan.org'}

<section class="max-w-[1400px] mx-auto px-5 sm:px-7 pt-10 pb-6">

    {* ============== PAGE HEADER ============== *}
    <header class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 md:gap-8">
        <div class="min-w-0">
            <div class="flex items-center gap-3 mb-3">
                <span class="font-mono text-[10.5px] uppercase tracking-widest2 text-fg-tertiary">Base Sepolia</span>
                <span class="inline-flex h-1.5 w-1.5 rounded-full bg-immune-500 pulse-soft" aria-hidden="true"></span>
                <span class="font-mono text-[10.5px] uppercase tracking-widest2 text-immune-500">Live</span>
            </div>
            <h1 class="font-display text-[42px] sm:text-[60px] font-light tracking-tightest text-fg-primary leading-[1.0]">
                Network activity
            </h1>
            <p class="text-fg-secondary text-[14px] sm:text-[15px] mt-4 max-w-[640px] leading-[1.6]">
                Every contract event the indexer reads off-chain &mdash; CRE per-check verifications,
                jury verdicts, challenges, and antibody lifecycle &mdash; as it lands on Base Sepolia.
            </p>
        </div>
        <div class="md:text-right md:shrink-0 flex flex-col md:items-end gap-2">
            <a href="/antibodies" class="inline-flex items-center gap-1.5 font-mono text-[10.5px] uppercase tracking-widest2 text-accent-soft hover:text-accent transition-colors">
                Open explorer
                <svg width="11" height="11" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 9L9 3M9 3H4M9 3V8" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round"/></svg>
            </a>
            <span class="font-mono text-[10px] uppercase tracking-widest2 text-fg-dim">the canonical registry</span>
        </div>
    </header>
</section>

{* ============== STATS BAR ============== *
   Same data source as the nav badge (/api/v1/network/stats) so the existing
   live poller keeps the values fresh without a page refresh. The demo
   "agents online" tile is gone; the lead tile is now antibodies active. *}
<section class="relative bg-ink-sunken border-y border-ink-line/60">
    <div class="relative max-w-[1400px] mx-auto px-5 sm:px-7 py-6">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-y-6 md:gap-0">

            <div class="md:px-7 md:first:pl-0 md:border-r md:border-ink-line/60">
                <div class="font-mono text-[10.5px] uppercase tracking-widest2 text-fg-tertiary mb-2">Antibodies active</div>
                <div data-stat="antibodies_active" class="font-display text-[44px] font-light tracking-tighter text-fg-primary leading-none tabular-nums">-</div>
                <div class="font-mono text-[11px] text-immune-500 tabular-nums mt-3" data-delta="antibodies_active">&nbsp;</div>
            </div>

            <div class="md:px-7 md:border-r md:border-ink-line/60">
                <div class="font-mono text-[10.5px] uppercase tracking-widest2 text-fg-tertiary mb-2">Cache hits / hr</div>
                <div data-stat="cache_hits_per_hour" class="font-display text-[44px] font-light tracking-tighter text-fg-primary leading-none tabular-nums">-</div>
                <div class="font-mono text-[11px] text-immune-500 tabular-nums mt-3" data-delta="cache_hits_per_hour">&nbsp;</div>
            </div>

            <div class="md:px-7 md:border-r md:border-ink-line/60">
                <div class="font-mono text-[10.5px] uppercase tracking-widest2 text-fg-tertiary mb-2">LLM calls saved</div>
                <div data-stat="llm_calls_saved" class="font-display text-[44px] font-light tracking-tighter text-threat-300 leading-none tabular-nums">-</div>
                <div class="font-mono text-[11px] text-fg-tertiary mt-3">
                    <span class="text-immune-500" data-compute-saved="llm_calls_saved">&approx; $0</span> in compute
                </div>
            </div>

            <div class="md:px-7">
                <div class="font-mono text-[10.5px] uppercase tracking-widest2 text-fg-tertiary mb-2">Value protected</div>
                <div data-stat-money="value_protected_usd" class="font-display text-[44px] font-light tracking-tighter text-accent-soft leading-none tabular-nums">-</div>
                <div class="font-mono text-[11px] text-immune-500 tabular-nums mt-3" data-delta-money="value_protected_usd">&nbsp;</div>
            </div>

        </div>
    </div>
</section>

<section class="max-w-[1400px] mx-auto px-5 sm:px-7 pt-10 pb-16">
    {* ============== ON-CHAIN EVENT FEED (full-page, single scroll) ============== *}
    <div>
            <header class="pb-4 border-b border-ink-line/40 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                <div class="flex items-center gap-3">
                    <span class="inline-flex h-1.5 w-1.5 rounded-full bg-immune-500 pulse-soft" aria-hidden="true"></span>
                    <span class="font-mono text-[10.5px] uppercase tracking-widest2 text-fg-tertiary">On-chain event log</span>
                    <span class="font-mono text-[10px] text-fg-dim">live (latest 60)</span>
                </div>
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[10px] text-fg-dim">
                    <span class="inline-flex items-center gap-1.5"><span class="inline-flex h-1.5 w-1.5 rounded-full bg-caution-300"></span>CRE / challenge</span>
                    <span class="inline-flex items-center gap-1.5"><span class="inline-flex h-1.5 w-1.5 rounded-full bg-immune-300"></span>verdict</span>
                    <span class="inline-flex items-center gap-1.5"><span class="inline-flex h-1.5 w-1.5 rounded-full bg-threat-300"></span>slash</span>
                </div>
            </header>

            <div class="mt-1">
                <table class="w-full">
                    <thead class="sticky top-0 bg-ink-base/95 backdrop-blur z-10">
                        <tr class="border-b border-ink-line/40">
                            <th class="font-mono text-[9.5px] uppercase tracking-widest2 text-fg-tertiary font-normal text-left pl-5 sm:pl-7 pr-4 py-3 w-24">When</th>
                            <th class="font-mono text-[9.5px] uppercase tracking-widest2 text-fg-tertiary font-normal text-left pr-4 py-3 w-36">Event</th>
                            <th class="font-mono text-[9.5px] uppercase tracking-widest2 text-fg-tertiary font-normal text-left pr-5 sm:pr-7 py-3">Detail</th>
                            <th class="font-mono text-[9.5px] uppercase tracking-widest2 text-fg-tertiary font-normal text-right pr-5 sm:pr-7 py-3 w-20">Tx</th>
                        </tr>
                    </thead>
                    <tbody data-event-body>
                    {if count($events ?? []) === 0}
                        <tr><td colspan="4" class="px-7 py-10 text-center font-mono text-[11.5px] text-fg-dim" data-event-empty>
                            No on-chain events ingested yet. Rows appear as the indexer reads Base Sepolia.
                        </td></tr>
                    {/if}
                    {foreach $events ?? [] as $e}
                        {var $meta = $eventMeta[$e['event_name']] ?? [$e['event_name'], 'text-fg-tertiary', 'bg-fg-dim']}
                        {var $p = $e['payload']}
                        <tr class="border-b border-ink-line/30 last:border-0 hover:bg-ink-elevated/30 transition-colors align-top"
                            data-evkey="{$e['block_number']}:{$e['log_index']}:{$e['id']}" data-ts="{$e['occurred_at']}">
                            <td class="pl-5 sm:pl-7 pr-4 py-2.5 font-mono text-[10.5px] text-fg-dim tabular-nums whitespace-nowrap" data-time>{format('timeago', $e['occurred_at'])}</td>
                            <td class="pr-4 py-2.5">
                                <span class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-widest2 {$meta[1]}">
                                    <span class="inline-flex h-1.5 w-1.5 rounded-full {$meta[2]}"></span>{$meta[0]}
                                </span>
                            </td>
                            <td class="pr-5 sm:pr-7 py-2.5 text-[12px] text-fg-secondary leading-snug break-words font-mono">
                                {if $e['event_name'] === 'NovelVerification.Verified'}
                                    {var $vTone = match ($p['verdictLabel'] ?? '') {
                                        'MALICIOUS'  => 'text-threat-300',
                                        'SUSPICIOUS' => 'text-caution-300',
                                        'BENIGN'     => 'text-immune-500',
                                        default      => 'text-fg-secondary',
                                    }}
                                    <span class="{$vTone} font-semibold">{$p['verdictLabel'] ?? '?'}</span>
                                    <span class="text-fg-dim">&middot; confidence {$p['confidence'] ?? 0}% &middot; severity {$p['severity'] ?? 0}</span>
                                {elseif $e['event_name'] === 'NovelVerification.VerificationRequested'}
                                    <span class="text-fg-dim">check</span> {substr($p['checkId'] ?? '0x', 0, 14)}&hellip;
                                {elseif $e['event_name'] === 'CREVerdictReceiver.VerdictReceived'}
                                    {var $valid = (int) ($p['validVotes'] ?? 0)}
                                    {var $invalid = (int) ($p['invalidVotes'] ?? 0)}
                                    {var $total = $valid + $invalid}
                                    {var $upheld = $valid >= $invalid}
                                    <span class="{if $upheld}text-immune-300{else}text-threat-300{/if} font-semibold">
                                        {if $upheld}{$valid}-of-{$total} VALID{else}{$invalid}-of-{$total} INVALID{/if}
                                    </span>
                                    <span class="text-fg-dim">&middot; antibody {substr($p['antibodyId'] ?? '0x', 0, 12)}&hellip;</span>
                                {elseif $e['event_name'] === 'ChallengeManager.VerdictRequested'}
                                    <span class="text-fg-dim">antibody</span> {substr($p['antibodyId'] ?? '0x', 0, 14)}&hellip;
                                {elseif $e['event_name'] === 'ChallengeManager.Resolved'}
                                    {var $inv = !empty($p['invalid'])}
                                    <span class="{if $inv}text-threat-300{else}text-immune-300{/if} font-semibold">{if $inv}INVALIDATED{else}UPHELD{/if}</span>
                                    <span class="text-fg-dim">&middot; antibody {substr($p['antibodyId'] ?? '0x', 0, 12)}&hellip;</span>
                                {elseif $e['event_name'] === 'Registry.Matched'}
                                    <span class="text-threat-300 font-semibold">blocked</span>
                                    <span class="text-fg-dim">&middot; matched antibody {substr($p['antibodyId'] ?? '0x', 0, 12)}&hellip;</span>
                                {elseif $e['event_name'] === 'Registry.Checked'}
                                    <span class="text-immune-500 font-semibold">allowed</span><span class="text-fg-dim"> &middot; no antibody match</span>
                                {elseif isset($p['antibodyId'])}
                                    <span class="text-fg-dim">antibody</span> {substr($p['antibodyId'], 0, 14)}&hellip;
                                {elseif isset($p['keccakId'])}
                                    <span class="text-fg-dim">antibody</span> {substr($p['keccakId'], 0, 14)}&hellip;
                                {elseif isset($p['publisher'])}
                                    <span class="text-fg-dim">publisher</span> {substr($p['publisher'], 0, 12)}&hellip;
                                {else}
                                    <span class="text-fg-dim">block #{$e['block_number']}</span>
                                {/if}
                            </td>
                            <td class="pr-5 sm:pr-7 py-2.5 text-right whitespace-nowrap">
                                <a href="{$explorer}/tx/{$e['tx_hash']}" target="_blank" rel="noopener" class="font-mono text-[10.5px] text-accent-soft hover:text-accent transition-colors">
                                    {substr($e['tx_hash'], 0, 8)}&hellip;
                                </a>
                            </td>
                        </tr>
                    {/foreach}
                    </tbody>
                </table>
                <div data-load-sentinel class="py-6 text-center font-mono text-[10.5px] uppercase tracking-widest2 text-fg-dim">
                    <span data-load-label>scroll for older events</span>
                </div>
            </div>
        </div>
    </div>
</section>

<script src="{asset('/javascripts/live.js')}"></script>
<script>
(function () {
  function fmtNumber(v) {
    if (v === null || v === undefined || v === '') return '-';
    const n = Number(v);
    return Number.isFinite(n) ? n.toLocaleString('en-US', { maximumFractionDigits: 0 }) : '-';
  }
  function fmtMoney(v) {
    if (v === null || v === undefined || v === '') return '-';
    const n = Number(v);
    return Number.isFinite(n) ? '$' + n.toLocaleString('en-US', { maximumFractionDigits: 0 }) : '-';
  }
  function fmtDelta(v, money) {
    if (v === null || v === undefined || v === '') return ' ';
    const n = Number(v);
    if (!Number.isFinite(n)) return ' ';
    const sign = n >= 0 ? '+' : '-';
    return sign + (money ? '$' : '') + Math.abs(n).toLocaleString('en-US', { maximumFractionDigits: 0 }) + ' in 1h';
  }
  function setText(el, next) { if (el.textContent !== next) el.textContent = next; }

  Live.poll('/api/v1/network/stats', 4000, function (data) {
    const tiles = data.tiles || {};
    document.querySelectorAll('[data-stat]').forEach(function (el) {
      const m = el.getAttribute('data-stat');
      if (tiles[m]) setText(el, fmtNumber(tiles[m].value));
    });
    document.querySelectorAll('[data-stat-money]').forEach(function (el) {
      const m = el.getAttribute('data-stat-money');
      if (tiles[m]) setText(el, fmtMoney(tiles[m].value));
    });
    document.querySelectorAll('[data-delta]').forEach(function (el) {
      const m = el.getAttribute('data-delta');
      if (tiles[m]) setText(el, fmtDelta(tiles[m].delta_1h, false));
    });
    document.querySelectorAll('[data-delta-money]').forEach(function (el) {
      const m = el.getAttribute('data-delta-money');
      if (tiles[m]) setText(el, fmtDelta(tiles[m].delta_1h, true));
    });
    document.querySelectorAll('[data-compute-saved]').forEach(function (el) {
      const m = el.getAttribute('data-compute-saved');
      const tile = tiles[m];
      if (!tile) return;
      const n = Number(tile.value);
      if (!Number.isFinite(n) || n <= 0) { setText(el, '≈ $0'); return; }
      const usd = n * 0.00015;
      if (usd < 0.01) setText(el, '≈ <$0.01');
      else if (usd < 1) setText(el, '≈ $' + usd.toFixed(2));
      else setText(el, '≈ $' + usd.toLocaleString('en-US', { maximumFractionDigits: 0 }));
    });
  });
})();

// ============================================================================
// On-chain event feed poll: re-renders the latest contract events every 4s.
// Static snapshot (no cursor) — cheap at this volume and keeps timestamps fresh.
// Pauses when the tab is hidden.
// ============================================================================
(function () {
  const EXPLORER = {$explorer};

  const META = {
    'Registry.Published':                      ['Published',      'text-accent-soft',  'bg-accent-soft'],
    'Registry.Matured':                        ['Matured',        'text-immune-500',   'bg-immune-500'],
    'Registry.Expired':                        ['Expired',        'text-fg-tertiary',  'bg-fg-dim'],
    'Registry.Retired':                        ['Retired',        'text-fg-tertiary',  'bg-fg-dim'],
    'Registry.Slashed':                        ['Slashed',        'text-threat-300',   'bg-threat-300'],
    'Registry.ChallengeOpened':                ['Challenged',     'text-caution-300',  'bg-caution-300'],
    'ChallengeManager.VerdictRequested':       ['Challenge open', 'text-caution-300',  'bg-caution-300'],
    'ChallengeManager.Escalated':              ['Escalated',      'text-caution-500',  'bg-caution-500'],
    'ChallengeManager.Resolved':               ['Resolved',       'text-immune-300',   'bg-immune-300'],
    'CREVerdictReceiver.VerdictReceived':      ['Jury verdict',   'text-immune-300',   'bg-immune-300'],
    'Registry.Matched':                        ['Check blocked',  'text-threat-300',   'bg-threat-300'],
    'Registry.Checked':                        ['Check allowed',  'text-immune-500',   'bg-immune-500'],
    'NovelVerification.VerificationRequested': ['CRE requested',  'text-accent-soft',  'bg-accent-soft'],
    'NovelVerification.Verified':              ['CRE verdict',    'text-caution-300',  'bg-caution-300'],
    'Reputation.Matured':                      ['Rep +matured',   'text-immune-500',   'bg-immune-500'],
    'Reputation.ChallengeWon':                 ['Rep +won',       'text-immune-500',   'bg-immune-500'],
    'Reputation.Slashed':                      ['Rep slashed',    'text-threat-300',   'bg-threat-300'],
    'Reputation.GenesisGranted':               ['Rep genesis',    'text-accent-soft',  'bg-accent-soft'],
    'Registry.BondLocked':                     ['Bond locked',    'text-fg-secondary', 'bg-fg-tertiary'],
    'Registry.BondReleased':                   ['Bond released',  'text-fg-secondary', 'bg-fg-tertiary'],
    'ProtectedSet.ProtectedUpdated':           ['Protected set',  'text-immune-300',   'bg-immune-300'],
  };

  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  function timeAgo(iso) {
    if (!iso) return '-';
    // Postgres hands back "2026-06-13 17:45:41.544255+00": space separator,
    // microseconds, and a colon-less "+00" offset that Date.parse rejects.
    // Normalise to RFC3339 ("…T17:45:41+00:00") before parsing.
    let s = String(iso).replace(' ', 'T').replace(/\.\d+/, '');
    s = s.replace(/([+-]\d\d)$/, '$1:00').replace(/([+-]\d\d)(\d\d)$/, '$1:$2');
    const then = Date.parse(s);
    if (!Number.isFinite(then)) return '-';
    const sec = Math.max(0, Math.floor((Date.now() - then) / 1000));
    if (sec < 60)        return sec + 's ago';
    if (sec < 3600)      return Math.floor(sec / 60) + 'm ago';
    if (sec < 86400)     return Math.floor(sec / 3600) + 'h ago';
    if (sec < 86400 * 7) return Math.floor(sec / 86400) + 'd ago';
    return new Date(then).toISOString().slice(0, 10);
  }
  function clip(hex, n) { return hex ? escapeHtml(String(hex).slice(0, n)) + '…' : '?'; }

  function detail(name, p) {
    p = p || {};
    if (name === 'NovelVerification.Verified') {
      const tone = { 'MALICIOUS': 'text-threat-300', 'SUSPICIOUS': 'text-caution-300', 'BENIGN': 'text-immune-500' }[p.verdictLabel] || 'text-fg-secondary';
      return '<span class="' + tone + ' font-semibold">' + escapeHtml(p.verdictLabel || '?') + '</span>' +
             '<span class="text-fg-dim"> · confidence ' + (p.confidence || 0) + '% · severity ' + (p.severity || 0) + '</span>';
    }
    if (name === 'NovelVerification.VerificationRequested') {
      return '<span class="text-fg-dim">check</span> ' + clip(p.checkId, 14);
    }
    if (name === 'CREVerdictReceiver.VerdictReceived') {
      const valid = Number(p.validVotes || 0), invalid = Number(p.invalidVotes || 0), total = valid + invalid;
      const upheld = valid >= invalid;
      const label = upheld ? (valid + '-of-' + total + ' VALID') : (invalid + '-of-' + total + ' INVALID');
      return '<span class="' + (upheld ? 'text-immune-300' : 'text-threat-300') + ' font-semibold">' + label + '</span>' +
             '<span class="text-fg-dim"> · antibody ' + clip(p.antibodyId, 12) + '</span>';
    }
    if (name === 'ChallengeManager.VerdictRequested') {
      return '<span class="text-fg-dim">antibody</span> ' + clip(p.antibodyId, 14);
    }
    if (name === 'ChallengeManager.Resolved') {
      const inv = !!p.invalid;
      return '<span class="' + (inv ? 'text-threat-300' : 'text-immune-300') + ' font-semibold">' + (inv ? 'INVALIDATED' : 'UPHELD') + '</span>' +
             '<span class="text-fg-dim"> · antibody ' + clip(p.antibodyId, 12) + '</span>';
    }
    if (name === 'Registry.Matched') {
      return '<span class="text-threat-300 font-semibold">blocked</span>' +
             '<span class="text-fg-dim"> · matched antibody ' + clip(p.antibodyId, 12) + '</span>';
    }
    if (name === 'Registry.Checked') {
      return '<span class="text-immune-500 font-semibold">allowed</span><span class="text-fg-dim"> · no antibody match</span>';
    }
    if (p.antibodyId) return '<span class="text-fg-dim">antibody</span> ' + clip(p.antibodyId, 14);
    if (p.keccakId)   return '<span class="text-fg-dim">antibody</span> ' + clip(p.keccakId, 14);
    if (p.publisher)  return '<span class="text-fg-dim">publisher</span> ' + clip(p.publisher, 12);
    return '';
  }

  function keyOf(e) { return e.block_number + ':' + e.log_index + ':' + e.id; }

  function renderRow(e) {
    const meta = META[e.event_name] || [e.event_name, 'text-fg-tertiary', 'bg-fg-dim'];
    const d = detail(e.event_name, e.payload) || '<span class="text-fg-dim">block #' + e.block_number + '</span>';
    return (
      '<tr class="border-b border-ink-line/30 last:border-0 hover:bg-ink-elevated/30 transition-colors align-top" data-evkey="' + keyOf(e) + '" data-ts="' + escapeHtml(e.occurred_at) + '">' +
        '<td class="pl-5 sm:pl-7 pr-4 py-2.5 font-mono text-[10.5px] text-fg-dim tabular-nums whitespace-nowrap" data-time>' + timeAgo(e.occurred_at) + '</td>' +
        '<td class="pr-4 py-2.5"><span class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-widest2 ' + meta[1] + '">' +
          '<span class="inline-flex h-1.5 w-1.5 rounded-full ' + meta[2] + '"></span>' + escapeHtml(meta[0]) + '</span></td>' +
        '<td class="pr-5 sm:pr-7 py-2.5 text-[12px] text-fg-secondary leading-snug break-words font-mono">' + d + '</td>' +
        '<td class="pr-5 sm:pr-7 py-2.5 text-right whitespace-nowrap">' +
          '<a href="' + EXPLORER + '/tx/' + escapeHtml(e.tx_hash) + '" target="_blank" rel="noopener" class="font-mono text-[10.5px] text-accent-soft hover:text-accent transition-colors">' +
          escapeHtml(String(e.tx_hash).slice(0, 8)) + '…</a></td>' +
      '</tr>'
    );
  }

  const tbody = document.querySelector('[data-event-body]');
  function seenKeys() {
    const s = new Set();
    if (tbody) tbody.querySelectorAll('tr[data-evkey]').forEach(function (tr) { s.add(tr.getAttribute('data-evkey')); });
    return s;
  }
  function refreshTimes() {
    if (!tbody) return;
    tbody.querySelectorAll('tr[data-ts]').forEach(function (tr) {
      const cell = tr.querySelector('[data-time]');
      if (cell) cell.textContent = timeAgo(tr.getAttribute('data-ts'));
    });
  }

  // Live poll: PREPEND only events we haven't shown yet (newest on top) so the
  // older rows the user scrolled back to load are never wiped; refresh the
  // relative timestamps each tick.
  function tick() {
    fetch('/api/v1/dashboard/events', { headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (data) {
        if (!data || !Array.isArray(data.events) || !tbody) return;
        const seen = seenKeys();
        const fresh = data.events.filter(function (e) { return !seen.has(keyOf(e)); });
        if (fresh.length) {
          const empty = tbody.querySelector('[data-event-empty]');
          if (empty && empty.closest('tr')) empty.closest('tr').remove();
          tbody.insertAdjacentHTML('afterbegin', fresh.map(renderRow).join(''));
        }
        refreshTimes();
      })
      .catch(function () { /* swallow: next tick retries */ });
  }

  function loop() {
    if (document.visibilityState === 'visible') tick();
    setTimeout(loop, 4000);
  }
  setTimeout(loop, 800);

  // Infinite scroll: when the sentinel scrolls into view, fetch the next page
  // of OLDER events (keyset cursor = the oldest row shown) and append them.
  (function () {
    const sentinel = document.querySelector('[data-load-sentinel]');
    const label = document.querySelector('[data-load-label]');
    if (!sentinel || !tbody || !('IntersectionObserver' in window)) return;
    let loading = false, exhausted = false;
    function loadOlder() {
      if (loading || exhausted) return;
      const rows = tbody.querySelectorAll('tr[data-evkey]');
      if (!rows.length) return;
      const cur = rows[rows.length - 1].getAttribute('data-evkey').split(':');
      loading = true;
      if (label) label.textContent = 'loading…';
      fetch('/api/v1/dashboard/events?before_block=' + cur[0] + '&before_log=' + cur[1] + '&before_id=' + cur[2],
            { headers: { 'Accept': 'application/json' } })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (data) {
          const evs = (data && Array.isArray(data.events)) ? data.events : [];
          if (evs.length === 0) {
            exhausted = true;
            if (label) label.textContent = 'end of log';
            observer.disconnect();
            return;
          }
          tbody.insertAdjacentHTML('beforeend', evs.map(renderRow).join(''));
          refreshTimes();
          if (label) label.textContent = 'scroll for older events';
        })
        .catch(function () { if (label) label.textContent = 'scroll for older events'; })
        .finally(function () { loading = false; });
    }
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) { if (en.isIntersecting) loadOlder(); });
    }, { rootMargin: '300px' });
    observer.observe(sentinel);
  })();
})();
</script>

{/block}
