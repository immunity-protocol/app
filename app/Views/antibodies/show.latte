{layout ../layouts/main.latte}

{block title}{$id} / Immunity antibody{/block}

{block content}

{*
 * Map the real Entry/Mirrors/Blocks/Publisher entities passed by the
 * controller into the shape this template was originally built around.
 * Fields without a direct source (impact ingestion graph, block_events
 * agent list) get placeholder values until those streams land.
 *}
{*
 * Friendly chain-id to name. Base Sepolia (84532) is the home chain of the
 * Registry; the rest are mirror destinations the relayer fans out to.
 *}
{var $chainNames = [
    84532    => 'base-sepolia',
    11155111 => 'sepolia',
    1        => 'ethereum',
    8453     => 'base',
    42161    => 'arbitrum',
    10       => 'optimism',
]}
{*
 * Block-explorer base URLs per chain. `null` means we don't link out
 * (the row will render the hash as plain text).
 *}
{var $chainExplorerTx = [
    84532    => 'https://sepolia.basescan.org/tx/',
    11155111 => 'https://sepolia.etherscan.io/tx/',
    1        => 'https://etherscan.io/tx/',
    8453     => 'https://basescan.org/tx/',
    42161    => 'https://arbiscan.io/tx/',
    10       => 'https://optimistic.etherscan.io/tx/',
]}
{var $primaryMatcher = $entry->primary_matcher}
{var $hasMatcher = is_object($primaryMatcher) || (is_array($primaryMatcher) && $primaryMatcher !== [])}
{var $primaryKind = match($entry->type) {
  'address'      => 'address',
  'call_pattern' => 'call_pattern',
  'bytecode'     => 'bytecode',
  'graph'        => 'graph',
  'semantic'     => 'semantic',
  default        => 'unknown',
}}
{var $primaryValue = !$hasMatcher ? '(envelope not yet hydrated from Lighthouse)' : match(true) {
  $entry->type === 'address'      => $primaryMatcher->target ?? '',
  $entry->type === 'call_pattern' => trim(($primaryMatcher->target ?? '') . ' ' . ($primaryMatcher->selector ?? '')),
  $entry->type === 'bytecode'     => $primaryMatcher->bytecodeHash ?? '',
  $entry->type === 'graph'        => ($primaryMatcher->taintSetId ?? '') . ' size=' . ($primaryMatcher->size ?? '?'),
  $entry->type === 'semantic'     => ($primaryMatcher->flavor ?? '') . (isset($primaryMatcher->markerHint) ? ' "' . $primaryMatcher->markerHint . '"' : ''),
  default                         => json_encode($primaryMatcher),
}}
{var $publisherAddr = '0x' . bin2hex($entry->publisher)}
{*
 * Action panel state. evidence_cid is bytea NOT NULL but a fresh antibody
 * with no uploaded envelope carries 32 zero bytes; treat that as "no
 * envelope". The challenge window is open while the antibody is on PROBATION
 * (before it matures); once active the action disappears.
 *}
{var $evidenceCidHex = '0x' . bin2hex($entry->evidence_cid)}
{var $hasEvidenceCid = bin2hex($entry->evidence_cid) !== str_repeat('0', 64)}
{var $evidenceUrl = $hasEvidenceCid ? 'https://gateway.lighthouse.storage/ipfs/' . \App\Models\Core\Cid::digestToCidV0($entry->evidence_cid) : null}
{var $challengeOpen = $entry->isProbation()}
{*
 * Threat-centric: $id is the Threat ID (IMM-T-YYYY-NNNN) when routed via
 * /threat; $entry is the headline (earliest corroborating) antibody whose
 * envelope/evidence drive the panels. Falls back to the antibody imm_id for the
 * legacy /antibody route with no threat.
 *}
{var $ab = [
  'id'             => $id,
  'headline_imm'   => $entry->imm_id,
  'keccak'         => '0x' . bin2hex($entry->keccak_id),
  'type'           => strtoupper($entry->type),
  'verdict'        => strtoupper($entry->verdict),
  'confidence'     => (float) $entry->confidence,
  'severity'       => $entry->severity,
  'status'         => strtoupper($entry->status),
  'publisher'      => $entry->publisher_ens ?? substr($publisherAddr, 0, 10) . '..' . substr($publisherAddr, -6),
  'publisher_addr' => $publisherAddr,
  'bond'           => (float) $entry->bond_amount,
  'created_at'    => $entry->created_at,
  'mirrored_to'   => array_map(fn ($m) => $m->chain_name, $mirrors),

  'envelope' => [
    'primary'   => ['kind' => $primaryKind, 'value' => $primaryValue],
    'secondary' => [],
    'scope'     => array_values(array_unique(array_merge(
        [(int) ($primaryMatcher->chainId ?? 84532)],
        array_map(fn ($m) => (int) $m->chain_id, $mirrors),
    ))),
    'exception' => 'none',
  ],

  'evidence' => [
    'reasoning'       => $entry->redacted_reasoning ?? null,
    'tee_attestation' => \App\Models\Core\Hex::isZero($entry->attestation) ? null : \App\Models\Core\Hex::toHex($entry->attestation),
    'evidence_cid'    => \App\Models\Core\Hex::isZero($entry->evidence_cid) ? null : \App\Models\Core\Hex::toHex($entry->evidence_cid),
    'sealed'          => !\App\Models\Core\Hex::isZero($entry->attestation),
  ],

  'impact' => [
    'cache_hits'                => $impact['cache_hits'],
    'agents_synced'             => $impact['agents_synced'],
    'blocks_made'               => $impact['blocks_made'],
    'pool_reverts'              => $impact['pool_reverts'] ?? 0,
    'value_protected_usd'       => (float) $impact['value_protected_usd'],
    'publisher_earnings_usdc'   => (float) ($impact['publisher_earnings_usdc'] ?? 0),
    'ingestion'                 => $impact['ingestion'],
    'propagation_seconds'       => $impact['propagation_seconds'] ?? null,
    'block_events'       => array_map(fn ($b) => [
      'agent'    => $b->agent_id,
      'method'   => $b->chain_id == 84532 ? 'SDK check()' : 'Uniswap v4 hook',
      'chain'    => isset($chainNames[$b->chain_id])
                        ? 'evm:' . $b->chain_id . ' (' . $chainNames[$b->chain_id] . ')'
                        : 'evm:' . $b->chain_id,
      'when_iso' => $b->occurred_at,
    ], $blocks),
  ],

  'mirrors' => array_map(fn ($m) => [
    'chain'        => $m->chain_name,
    'tx'           => '0x' . substr(bin2hex($m->mirror_tx_hash), 0, 8) . '..' . substr(bin2hex($m->mirror_tx_hash), -4),
    'tx_full'      => '0x' . bin2hex($m->mirror_tx_hash),
    'explorer_url' => isset($chainExplorerTx[$m->chain_id])
                          ? $chainExplorerTx[$m->chain_id] . '0x' . bin2hex($m->mirror_tx_hash)
                          : null,
    'state'        => $m->status,
  ], $mirrors),
]}

<section class="max-w-[1400px] mx-auto px-7 pt-10 pb-16">

    {* ----------- BREADCRUMB ----------- *}
    <nav class="font-mono text-[10.5px] uppercase tracking-widest2 text-fg-tertiary mb-8 flex items-center gap-2" aria-label="Breadcrumb">
        <a href="/antibodies" class="hover:text-fg-secondary transition-colors">Threats</a>
        <span class="text-fg-dim" aria-hidden="true">/</span>
        <span class="text-fg-secondary">{$ab['id']}</span>
    </nav>

    {* ============== HEADER ============== *}
    {var $verdictTone = $ab['verdict'] === 'MALICIOUS' ? 'text-threat-500' : 'text-caution-500'}
    {var $statusBadge = match($ab['status']) {
        'ACTIVE'     => 'bg-immune-500/10 text-immune-500 border-immune-500/30',
        'PROBATION'  => 'bg-accent/10 text-accent border-accent/30',
        'CHALLENGED' => 'bg-caution-500/10 text-caution-500 border-caution-500/30',
        'EXPIRED'    => 'bg-fg-dim/15 text-fg-tertiary border-ink-line/60',
        'SLASHED'    => 'bg-threat-500/15 text-threat-500 border-threat-500/30',
        default      => 'bg-fg-dim/10 text-fg-tertiary border-ink-line/60',
    }}
    {* Enforcement tier — the single SDK rule. Protected targets cap at advisory. *}
    {var $isHardBlock = \App\Models\Core\EnforcementTier::isHardBlock($entry->corroboration_count, $entry->is_seeded === 1, $corroborationK, $isProtected)}

    <header class="mb-14">

        {* Threat ID + status pill + copy *}
        <div class="flex items-center gap-4 flex-wrap mb-3">
            <h1 class="font-mono text-[34px] text-fg-primary tracking-tight leading-none">{$ab['id']}</h1>
            <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-sm border font-mono text-[10px] uppercase tracking-widest2 {$statusBadge}">
                <span class="inline-flex h-1.5 w-1.5 rounded-full bg-current pulse-soft" aria-hidden="true"></span>
                {$ab['status']}
            </span>
            {* Enforcement tier — derived, not status-keyed. *}
            {if $isHardBlock}
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-sm border font-mono text-[10px] uppercase tracking-widest2 bg-threat-500/10 text-threat-500 border-threat-500/30" title="corroboration ≥ {$corroborationK} or seeded — agents hard-block on match">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.9" y1="4.9" x2="19.1" y2="19.1"/></svg>
                    Hard-block
                </span>
            {else}
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-sm border font-mono text-[10px] uppercase tracking-widest2 bg-caution-500/10 text-caution-500 border-caution-500/30" title="{$isProtected ? 'target is on the protected set — capped at advisory' : 'below corroboration threshold — advisory only'}">
                    Advisory{if $isProtected} (protected){/if}
                </span>
            {/if}
            {if $entry->is_seeded === 1}
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-sm border font-mono text-[10px] uppercase tracking-widest2 bg-accent/10 text-accent border-accent/30" title="genesis-seeded antibody">
                    Genesis
                </span>
            {/if}
            <button data-copy="{$ab['id']}" class="font-mono text-[10px] uppercase tracking-widest2 text-fg-dim hover:text-accent transition-colors inline-flex items-center gap-1.5" aria-label="Copy Threat ID">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                Copy
            </button>
        </div>

        {* Flagged-by summary — the corroboration headline of the threat view. *}
        {var $corroboratorCount = count($corroborationSet)}
        <p class="text-fg-secondary text-[14px] sm:text-[15px] mb-6 leading-[1.6]">
            Flagged by <span class="text-fg-primary tabular-nums">{$corroboratorCount}</span> independent publisher{$corroboratorCount === 1 ? '' : 's'} declaring the same primary matcher.
            {if $isHardBlock}Corroboration threshold met — agents hard-block on match.{else}Advisory until {$corroborationK} distinct publishers corroborate.{/if}
        </p>

        {* Matcher-hash row — the threat's on-chain identity (the shared bad thing). *}
        {var $matcherHashHex = $threat !== null ? '0x' . $threat->matcher_hash_hex : ($entry->primary_matcher_hash !== null ? '0x' . bin2hex($entry->primary_matcher_hash) : null)}
        {if $matcherHashHex !== null}
        <div class="flex items-center gap-3 mb-7">
            <span class="font-mono text-[10.5px] uppercase tracking-widest2 text-fg-tertiary shrink-0">Matcher</span>
            <code class="font-mono text-[12px] text-fg-secondary truncate min-w-0">{$matcherHashHex}</code>
            <button data-copy="{$matcherHashHex}" class="font-mono text-[10px] uppercase tracking-widest2 text-fg-dim hover:text-accent transition-colors inline-flex items-center gap-1.5 shrink-0" aria-label="Copy matcher hash">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                Copy
            </button>
        </div>
        {/if}

        {* Metadata strip: 5 cells *}
        <div class="border-t border-b border-ink-line/60 grid grid-cols-2 md:grid-cols-5 divide-x divide-ink-line/40">
            <div class="p-4">
                <div class="font-mono text-[10px] uppercase tracking-widest2 text-fg-tertiary mb-1.5">Type</div>
                <div class="font-mono text-[13px] uppercase tracking-widest2 text-accent-soft">{$ab['type']}</div>
            </div>
            <div class="p-4">
                <div class="font-mono text-[10px] uppercase tracking-widest2 text-fg-tertiary mb-1.5">Verdict</div>
                <div class="font-mono text-[13px] uppercase tracking-widest2 {$verdictTone}">{$ab['verdict']}</div>
            </div>
            <div class="p-4">
                <div class="font-mono text-[10px] uppercase tracking-widest2 text-fg-tertiary mb-1.5">Confidence</div>
                <div class="font-mono text-[15px] text-fg-primary tabular-nums">{format('decimal', $ab['confidence'], 1)}<span class="text-fg-tertiary text-[11px] ml-0.5">%</span></div>
            </div>
            <div class="p-4">
                <div class="font-mono text-[10px] uppercase tracking-widest2 text-fg-tertiary mb-1.5">Severity</div>
                <div class="flex items-center gap-2.5">
                    <span class="font-mono text-[15px] text-fg-primary tabular-nums">{$ab['severity']}</span>
                    <div class="h-1 w-16 bg-ink-line/60 rounded-full overflow-hidden">
                        <div class="h-full bg-threat-500" style="width: {$ab['severity']}%"></div>
                    </div>
                </div>
            </div>
            <div class="p-4">
                <div class="font-mono text-[10px] uppercase tracking-widest2 text-fg-tertiary mb-1.5">Value at risk</div>
                <div class="font-mono text-[15px] text-fg-primary tabular-nums">{format('money', $ab['impact']['value_protected_usd'])}</div>
            </div>
        </div>

        {var $publishTxHex = $entry->publish_tx_hash !== null ? '0x' . bin2hex($entry->publish_tx_hash) : null}
        {var $explorerUrl = $publishTxHex !== null
            ? 'https://sepolia.basescan.org/tx/' . $publishTxHex
            : 'https://sepolia.basescan.org/address/' . $ab['publisher_addr']}
        {* Publisher + timestamps row *}
        <div class="flex flex-wrap items-center gap-x-8 gap-y-3 mt-5 text-[12.5px]">
            <div class="flex items-center gap-2">
                <span class="font-mono text-[10.5px] uppercase tracking-widest2 text-fg-tertiary">Published by</span>
                <a href="/publisher/{$ab['publisher_addr']}" class="text-fg-primary hover:text-accent transition-colors" title="View publisher profile">{$ab['publisher']}</a>
                <a href="{$explorerUrl}"
                   target="_blank"
                   rel="noopener noreferrer"
                   title="{$publishTxHex !== null ? 'View publish transaction on Basescan' : 'View publisher on Basescan'}"
                   class="inline-flex items-center gap-1.5 font-mono text-[10.5px] uppercase tracking-widest2 text-fg-tertiary hover:text-fg-primary transition-colors border border-fg-tertiary/30 hover:border-fg-primary/40 rounded px-2 py-0.5">
                    View on explorer
                    {* Tabler icon: external-link (https://tabler.io/icons/icon/external-link) *}
                    <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6"/>
                        <path d="M11 13l9 -9"/>
                        <path d="M15 4h5v5"/>
                    </svg>
                </a>
            </div>
            <div class="flex items-center gap-2">
                <span class="font-mono text-[10.5px] uppercase tracking-widest2 text-fg-tertiary">Created</span>
                <span class="font-mono text-[11.5px] text-fg-secondary">{format('datetime', $entry->created_at)}</span>
            </div>
        </div>
    </header>

    {* ============== TWO-COLUMN BODY ============== *}
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-x-14 gap-y-10">

        {* ----------- MAIN COLUMN (panels fill in 6c-6f) ----------- *}
        <div class="space-y-10 min-w-0">

            {* ----------- ENVELOPE PANEL ----------- *}
            <section class="border border-ink-line/60 rounded-sm bg-ink-elevated/20">

                <header class="px-7 py-4 border-b border-ink-line/40 flex items-center justify-between gap-4">
                    <div class="flex items-center gap-3">
                        <span class="font-mono text-[10.5px] uppercase tracking-widest2 text-fg-tertiary">Envelope</span>
                        <span class="font-mono text-[10px] text-fg-dim">v1</span>
                    </div>
                    <span class="font-mono text-[10px] uppercase tracking-widest2 text-fg-dim">Signed payload</span>
                </header>

                <div class="px-7 py-6 space-y-7">

                    {* Primary matcher *}
                    <div>
                        <div class="flex items-center gap-2 mb-3">
                            <span class="font-mono text-[10px] uppercase tracking-widest2 text-fg-tertiary">Primary matcher</span>
                            <span class="font-mono text-[9.5px] uppercase tracking-widest2 text-accent-soft px-1.5 py-0.5 rounded-sm bg-accent/5 border border-accent/15">{$ab['envelope']['primary']['kind']}</span>
                        </div>
                        <div class="font-mono text-[13px] text-fg-primary bg-ink-sunken/60 border border-ink-line/40 rounded-sm px-4 py-3 break-all">{$ab['envelope']['primary']['value']}</div>
                    </div>

                    {* Secondary matchers — only rendered when at least one is present. *}
                    {if count($ab['envelope']['secondary']) > 0}
                        <div>
                            <div class="font-mono text-[10px] uppercase tracking-widest2 text-fg-tertiary mb-3">Secondary matchers</div>
                            <ul class="space-y-2.5">
                                {foreach $ab['envelope']['secondary'] as $m}
                                    <li class="flex items-start gap-3">
                                        <span class="font-mono text-[9.5px] uppercase tracking-widest2 text-fg-tertiary px-1.5 py-0.5 rounded-sm bg-ink-elevated/60 border border-ink-line/40 shrink-0 mt-0.5">{$m['kind']}</span>
                                        <code class="font-mono text-[12.5px] text-fg-secondary break-all min-w-0">{$m['value']}</code>
                                    </li>
                                {/foreach}
                            </ul>
                        </div>
                    {/if}

                    {* Scope: home chain first, mirrors after. *}
                    <div>
                        <div class="font-mono text-[10px] uppercase tracking-widest2 text-fg-tertiary mb-3">Scope</div>
                        <div class="flex flex-wrap gap-2">
                            {var $homeChain = $ab['envelope']['scope'][0] ?? null}
                            {foreach $ab['envelope']['scope'] as $chainId}
                                {var $chainLabel = isset($chainNames[$chainId]) ? $chainNames[$chainId] : 'evm:' . $chainId}
                                {var $isHome = $chainId === $homeChain}
                                <span class="inline-flex items-center gap-1.5 font-mono text-[11px] text-fg-secondary px-2 py-1 rounded-sm bg-ink-elevated/60 border border-ink-line/50">
                                    {$chainLabel}
                                    {if $isHome}
                                        <span class="font-mono text-[9px] uppercase tracking-widest2 text-fg-dim">home</span>
                                    {/if}
                                </span>
                            {/foreach}
                        </div>
                    </div>

                </div>
            </section>

            {* ----------- CORROBORATION PANEL ----------- *}
            {*
             * The hard-block story made visible: every publisher that independently
             * declared the same primary_matcher_hash. K corroborators flips an
             * antibody from advisory to hard-block.
             *}
            {var $corroborators = $corroborationSet}
            <section class="border border-ink-line/60 rounded-sm bg-ink-elevated/20">
                <header class="px-7 py-4 border-b border-ink-line/40 flex items-center justify-between gap-4">
                    <div class="flex items-center gap-3">
                        <span class="font-mono text-[10.5px] uppercase tracking-widest2 text-fg-tertiary">Corroboration</span>
                        <span class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-widest2 {count($corroborators) >= $corroborationK ? 'text-immune-500' : 'text-caution-500'}">
                            <span class="inline-flex h-1.5 w-1.5 rounded-full bg-current" aria-hidden="true"></span>
                            {count($corroborators)} of {$corroborationK} to hard-block
                        </span>
                    </div>
                    <span class="font-mono text-[10px] uppercase tracking-widest2 text-fg-dim">Same matcher hash</span>
                </header>
                <div class="px-7 py-6">
                    {if count($corroborators) <= 1}
                        <p class="text-[13px] text-fg-secondary leading-[1.7]">
                            No other publisher has independently declared this matcher yet. This antibody stands alone — advisory until {$corroborationK} distinct publishers corroborate.
                        </p>
                    {else}
                        <p class="text-[12.5px] text-fg-tertiary leading-[1.6] mb-4">
                            Corroborated by <span class="text-fg-primary">{count($corroborators)}</span> independent publisher{count($corroborators) === 1 ? '' : 's'} declaring the same primary matcher.
                        </p>
                        <ul class="divide-y divide-ink-line/30">
                            {foreach $corroborators as $c}
                                {var $cAddr = '0x' . bin2hex($c->publisher)}
                                {var $cName = $c->publisher_ens ?? substr($cAddr, 0, 10) . '..' . substr($cAddr, -6)}
                                {var $isHeadline = $c->id === $entry->id}
                                {var $cHasEvidence = !\App\Models\Core\Hex::isZero($c->evidence_cid)}
                                {var $cHasAttestation = !\App\Models\Core\Hex::isZero($c->attestation)}
                                {var $cEvidenceUrl = $cHasEvidence ? 'https://gateway.lighthouse.storage/ipfs/' . \App\Models\Core\Cid::digestToCidV0($c->evidence_cid) : null}
                                <li class="flex items-center justify-between gap-4 py-2.5">
                                    <div class="flex items-center gap-3 min-w-0">
                                        <a href="/publisher/{$cAddr}" class="{$c->publisher_ens !== null ? 'text-[12.5px]' : 'font-mono text-[11.5px]'} text-fg-primary hover:text-accent transition-colors truncate" title="{$cAddr}">{$cName}</a>
                                        {if $isHeadline}<span class="font-mono text-[9px] uppercase tracking-widest2 text-fg-dim shrink-0">headline</span>{/if}
                                        <span class="inline-flex items-center px-1.5 py-0.5 rounded-sm font-mono text-[9.5px] uppercase tracking-widest2 bg-ink-elevated/60 text-fg-tertiary shrink-0">{strtoupper($c->status)}</span>
                                    </div>
                                    <div class="flex items-center gap-3 shrink-0">
                                        {if $cHasAttestation}
                                            <span class="inline-flex items-center gap-1 font-mono text-[9.5px] uppercase tracking-widest2 text-immune-500" title="TEE-attested verdict">
                                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                                TEE
                                            </span>
                                        {else}
                                            <span class="font-mono text-[9.5px] uppercase tracking-widest2 text-fg-dim" title="curated by human, no TEE attestation">curated</span>
                                        {/if}
                                        {if $cHasEvidence}
                                            <a href="{$cEvidenceUrl}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 font-mono text-[9.5px] uppercase tracking-widest2 text-fg-tertiary hover:text-accent transition-colors" title="Evidence envelope on Lighthouse">
                                                Evidence
                                                <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
                                            </a>
                                        {else}
                                            <span class="font-mono text-[9.5px] uppercase tracking-widest2 text-fg-dim">no CID</span>
                                        {/if}
                                    </div>
                                </li>
                            {/foreach}
                        </ul>
                    {/if}
                </div>
            </section>

            {* ----------- EVIDENCE PANEL ----------- *}
            <section class="border border-ink-line/60 rounded-sm bg-ink-elevated/20">

                <header class="px-7 py-4 border-b border-ink-line/40 flex items-center justify-between gap-4">
                    <div class="flex items-center gap-3">
                        <span class="font-mono text-[10.5px] uppercase tracking-widest2 text-fg-tertiary">Evidence</span>
                        <span class="font-mono text-[10px] text-fg-dim">redacted public excerpt</span>
                    </div>
                    {if $ab['evidence']['sealed']}
                        <span class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-widest2 text-immune-500">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                            Sealed bundle
                        </span>
                    {/if}
                </header>

                <div class="px-7 py-6 space-y-7">

                    {* Reasoning excerpt *}
                    <div>
                        <div class="font-mono text-[10px] uppercase tracking-widest2 text-fg-tertiary mb-3">Reasoning excerpt</div>
                        {if $ab['evidence']['reasoning'] !== null && $ab['evidence']['reasoning'] !== ''}
                            <div class="text-[13.5px] text-fg-secondary leading-[1.7] whitespace-pre-line">{$ab['evidence']['reasoning']}</div>
                            <p class="font-mono text-[10px] text-fg-dim mt-4 italic">Full evidence (TEE-sealed) is fetchable by holders of the unsealing key. Public mirror carries hash only.</p>
                        {else}
                            <div class="text-[13px] text-fg-dim italic">(no reasoning recorded)</div>
                        {/if}
                    </div>

                    {* Attestation + CID grid *}
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-5 pt-2">

                        <div>
                            <div class="font-mono text-[10px] uppercase tracking-widest2 text-fg-tertiary mb-2">TEE attestation</div>
                            {if $ab['evidence']['tee_attestation'] !== null}
                                <div class="font-mono text-[11.5px] text-fg-secondary bg-ink-sunken/60 border border-ink-line/40 rounded-sm px-3 py-2 break-all">{$ab['evidence']['tee_attestation']}</div>
                            {else}
                                <div class="inline-flex items-center gap-2 px-3 py-2 rounded-sm bg-ink-sunken/40 border border-ink-line/30">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="text-accent-soft" aria-hidden="true">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                        <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"/>
                                        <path d="M12 7v5l3 3"/>
                                    </svg>
                                    <span class="font-mono text-[11px] uppercase tracking-widest2 text-fg-secondary">Curated by human</span>
                                </div>
                                <div class="font-mono text-[10.5px] text-fg-dim mt-1.5 px-1">Heuristically published from a known threat catalog, not derived from a TEE-verified verdict.</div>
                            {/if}
                        </div>

                        <div>
                            <div class="font-mono text-[10px] uppercase tracking-widest2 text-fg-tertiary mb-2">Evidence on Lighthouse</div>
                            {if $hasEvidenceCid}
                                <a href="{$evidenceUrl}" target="_blank" rel="noopener noreferrer"
                                   class="flex items-center gap-2 group"
                                   title="Open the public evidence envelope on the Lighthouse IPFS gateway">
                                    <code class="font-mono text-[11px] text-fg-secondary group-hover:text-accent bg-ink-sunken/60 border border-ink-line/40 group-hover:border-accent/40 rounded-sm px-3 py-2 break-all min-w-0 flex-1 transition-colors">{\App\Models\Core\Cid::digestToCidV0($entry->evidence_cid)}</code>
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="text-fg-dim group-hover:text-accent shrink-0 transition-colors"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
                                </a>
                                <div class="font-mono text-[10px] text-fg-dim mt-1.5 px-1">Public CIDv0 on Lighthouse IPFS — resolves the signed envelope.</div>
                            {else}
                                <div class="font-mono text-[11.5px] text-fg-dim italic px-3 py-2">(envelope not yet uploaded)</div>
                            {/if}
                        </div>
                    </div>

                    {* Encrypted context — non-zero context_hash means CRE-only sealed inputs. *}
                    {if !\App\Models\Core\Hex::isZero($entry->context_hash)}
                        <div class="flex items-center gap-2.5 pt-2">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="text-accent-soft shrink-0" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                            <span class="font-mono text-[11px] uppercase tracking-widest2 text-fg-secondary">Encrypted context (CRE-only)</span>
                            <span class="font-mono text-[10.5px] text-fg-dim normal-case tracking-normal">— sealed inputs readable only inside the verification runtime.</span>
                        </div>
                    {/if}

                </div>
            </section>

            {* ----------- NETWORK IMPACT PANEL ----------- *}
            {var $maxIng = max(1, max($ab['impact']['ingestion']))}
            <section class="border border-ink-line/60 rounded-sm bg-ink-elevated/20">

                <header class="px-7 py-4 border-b border-ink-line/40 flex items-center justify-between gap-4">
                    <div class="flex items-center gap-3">
                        <span class="font-mono text-[10.5px] uppercase tracking-widest2 text-fg-tertiary">Network impact</span>
                        <span class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-widest2 text-immune-500">
                            <span class="inline-flex h-1.5 w-1.5 rounded-full bg-immune-500 pulse-soft" aria-hidden="true"></span>
                            Live
                        </span>
                    </div>
                    <span class="font-mono text-[10px] uppercase tracking-widest2 text-fg-dim">Since publish</span>
                </header>

                {* Counters strip *}
                <div class="grid grid-cols-2 md:grid-cols-5 divide-x divide-ink-line/40 border-b border-ink-line/40">
                    <div class="px-6 py-5">
                        <div class="font-mono text-[10px] uppercase tracking-widest2 text-fg-tertiary mb-1.5">Cache hits</div>
                        <div class="font-mono text-[22px] text-fg-primary tabular-nums leading-none">{format('decimal', $ab['impact']['cache_hits'], 0)}</div>
                        <div class="font-mono text-[10.5px] text-fg-tertiary tabular-nums mt-1">SDK check() matches</div>
                    </div>
                    <div class="px-6 py-5">
                        <div class="font-mono text-[10px] uppercase tracking-widest2 text-fg-tertiary mb-1.5">Agents synced</div>
                        <div class="font-mono text-[22px] text-fg-primary tabular-nums leading-none">{format('decimal', $ab['impact']['agents_synced'], 0)}</div>
                        <div class="font-mono text-[10.5px] text-fg-tertiary tabular-nums mt-1">distinct callers</div>
                    </div>
                    <div class="px-6 py-5">
                        <div class="font-mono text-[10px] uppercase tracking-widest2 text-fg-tertiary mb-1.5">Attacks blocked</div>
                        <div class="font-mono text-[22px] text-threat-300 tabular-nums leading-none">{$ab['impact']['blocks_made']}</div>
                        <div class="font-mono text-[10.5px] text-fg-tertiary tabular-nums mt-1">tx-level intercepts</div>
                    </div>
                    <div class="px-6 py-5">
                        <div class="font-mono text-[10px] uppercase tracking-widest2 text-fg-tertiary mb-1.5">Pool reverts</div>
                        <div class="font-mono text-[22px] text-accent-soft tabular-nums leading-none">{$ab['impact']['pool_reverts']}</div>
                        <div class="font-mono text-[10.5px] text-fg-tertiary tabular-nums mt-1">Uniswap v4 hook</div>
                    </div>
                    <div class="px-6 py-5">
                        <div class="font-mono text-[10px] uppercase tracking-widest2 text-fg-tertiary mb-1.5">USD protected</div>
                        <div class="font-mono text-[22px] text-fg-primary tabular-nums leading-none">{format('money', $ab['impact']['value_protected_usd'])}</div>
                        <div class="font-mono text-[10.5px] text-fg-tertiary tabular-nums mt-1">{$ab['impact']['blocks_made'] === 0 ? 'no blocks recorded yet' : 'sum of tx value at intercept'}</div>
                    </div>
                </div>

                {* Ingestion sparkline (real histogram of check_event since publish) *}
                <div class="px-7 py-6 border-b border-ink-line/40">
                    <div class="flex items-center justify-between mb-3">
                        <span class="font-mono text-[10px] uppercase tracking-widest2 text-fg-tertiary">Hits over time</span>
                        <span class="font-mono text-[10px] text-fg-dim">each bar is one of {count($ab['impact']['ingestion'])} equal slices since publish</span>
                    </div>
                    <svg viewBox="0 0 600 90" preserveAspectRatio="none" class="w-full h-[90px]" aria-hidden="true">
                        <line x1="0" y1="89" x2="600" y2="89" stroke="rgba(232,232,227,0.06)" stroke-width="1"/>
                        {var $barW = 600 / count($ab['impact']['ingestion'])}
                        {foreach $ab['impact']['ingestion'] as $i => $v}
                            {var $h = ($v / $maxIng) * 78}
                            {var $x = $i * $barW + 1}
                            <rect x="{$x}" y="{89 - $h}" width="{$barW - 2}" height="{$h}" fill="rgba(122, 184, 122, 0.55)" rx="0.5"/>
                        {/foreach}
                    </svg>
                    <div class="flex justify-between mt-2 font-mono text-[9.5px] text-fg-dim">
                        <span>publish</span>
                        <span>now</span>
                    </div>
                </div>

                {* Recent intercepts *}
                <div class="px-7 py-6">
                    <div class="font-mono text-[10px] uppercase tracking-widest2 text-fg-tertiary mb-4">Recent intercepts</div>
                    <table class="w-full">
                        <thead>
                            <tr class="border-b border-ink-line/40">
                                <th class="font-mono text-[9.5px] uppercase tracking-widest2 text-fg-tertiary font-normal text-left pb-2.5">Agent</th>
                                <th class="font-mono text-[9.5px] uppercase tracking-widest2 text-fg-tertiary font-normal text-left pb-2.5">Method</th>
                                <th class="font-mono text-[9.5px] uppercase tracking-widest2 text-fg-tertiary font-normal text-left pb-2.5">Chain</th>
                                <th class="font-mono text-[9.5px] uppercase tracking-widest2 text-fg-tertiary font-normal text-right pb-2.5">When</th>
                            </tr>
                        </thead>
                        <tbody>
                        {if count($ab['impact']['block_events']) === 0}
                            <tr class="border-b border-ink-line/30 last:border-0">
                                <td colspan="4" class="py-6 text-center">
                                    <div class="font-mono text-[11.5px] text-fg-dim italic">No agent has had to block this antibody yet.</div>
                                    <div class="font-mono text-[10.5px] text-fg-dim mt-1.5">Intercepts appear here in real time as agents match this pattern in the wild.</div>
                                </td>
                            </tr>
                        {/if}
                        {foreach $ab['impact']['block_events'] as $e}
                            <tr class="border-b border-ink-line/30 last:border-0">
                                <td class="py-2.5 font-mono text-[12px] text-fg-secondary">{$e['agent']}</td>
                                <td class="py-2.5 font-mono text-[12px] text-fg-tertiary">{$e['method']}</td>
                                <td class="py-2.5 font-mono text-[11.5px] text-fg-tertiary">{$e['chain']}</td>
                                <td class="py-2.5 font-mono text-[11.5px] text-fg-tertiary text-right">{format('timeago', $e['when_iso'])}</td>
                            </tr>
                        {/foreach}
                        </tbody>
                    </table>
                </div>

            </section>

            {* ----------- CHALLENGE HISTORY PANEL ----------- *}
            {*
             * The challenge game made visible. Present only when this threat's
             * corroboration set has been challenged. Outcome: UPHELD (jury ruled
             * the antibody a real threat, challenger forfeits bond — enforcement
             * continues) vs STRUCK (ruled a false positive, publisher slashed).
             *}
            {if count($challenges) > 0}
            <section class="border border-ink-line/60 rounded-sm bg-ink-elevated/20">
                <header class="px-7 py-4 border-b border-ink-line/40 flex items-center gap-3">
                    <span class="font-mono text-[10.5px] uppercase tracking-widest2 text-fg-tertiary">Challenge history</span>
                </header>
                <div class="divide-y divide-ink-line/30">
                    {foreach $challenges as $ch}
                        {var $outTone = match($ch['outcome']) {
                            'upheld' => ['Upheld', 'text-immune-500', 'bg-immune-500/10', 'border-immune-500/30'],
                            'struck' => ['Struck (false positive)', 'text-threat-300', 'bg-threat-500/10', 'border-threat-500/30'],
                            default  => ['Pending jury', 'text-caution-500', 'bg-caution-500/10', 'border-caution-500/30'],
                        }}
                        <div class="px-7 py-5">
                            <div class="flex items-center justify-between gap-3 mb-3 flex-wrap">
                                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-sm border font-mono text-[10px] uppercase tracking-widest2 {$outTone[1]} {$outTone[2]} {$outTone[3]}">
                                    {$outTone[0]}
                                </span>
                                <span class="font-mono text-[10.5px] text-fg-dim">
                                    {if $ch['outcome'] === 'upheld'}challenger forfeited bond — antibody keeps enforcing{elseif $ch['outcome'] === 'struck'}publisher slashed — matcher cleared{else}challenge open — matured antibody keeps enforcing{/if}
                                </span>
                            </div>
                            <dl class="grid grid-cols-2 sm:grid-cols-4 gap-x-6 gap-y-3 text-[12px]">
                                <div>
                                    <dt class="font-mono text-[9.5px] uppercase tracking-widest2 text-fg-tertiary mb-1">Jury verdict</dt>
                                    <dd class="font-mono text-fg-secondary tabular-nums">{$ch['valid_votes']} valid / {$ch['invalid_votes']} invalid</dd>
                                </div>
                                <div>
                                    <dt class="font-mono text-[9.5px] uppercase tracking-widest2 text-fg-tertiary mb-1">Challenger</dt>
                                    <dd class="font-mono text-fg-secondary truncate">
                                        {if $ch['challenger']}<a href="/publisher/{$ch['challenger']}" class="hover:text-accent transition-colors" title="{$ch['challenger']}">{substr($ch['challenger'], 0, 6)}…{substr($ch['challenger'], -4)}</a>{else}—{/if}
                                    </dd>
                                </div>
                                <div>
                                    <dt class="font-mono text-[9.5px] uppercase tracking-widest2 text-fg-tertiary mb-1">Bond</dt>
                                    <dd class="font-mono text-fg-secondary tabular-nums">{if $ch['bond'] !== null}{$ch['bond']|number:2} USDC{else}—{/if}</dd>
                                </div>
                                <div>
                                    <dt class="font-mono text-[9.5px] uppercase tracking-widest2 text-fg-tertiary mb-1">Payout</dt>
                                    <dd class="font-mono text-fg-secondary tabular-nums">{if $ch['winner_payout'] !== null}{$ch['winner_payout']|number:2} USDC{else}—{/if}</dd>
                                </div>
                            </dl>
                            <div class="font-mono text-[10px] text-fg-dim mt-3">
                                Opened {format('timeago', $ch['opened_at'])}{if $ch['resolved_at']} · resolved {format('timeago', $ch['resolved_at'])}{/if}
                            </div>
                        </div>
                    {/foreach}
                </div>
            </section>
            {/if}

            {* ----------- MIRROR STATUS PANEL ----------- *}
            {*
             * Sync state is derived from how many of the configured chains
             * have a mirror row. `none` keeps the panel honest pre-relayer.
             *}
            {* The relayer only mirrors antibodies that have earned enforcement
             * authority (corroboration ≥ K or seeded). An advisory antibody
             * stays on its home chain — it is NOT mirror-eligible until it
             * matures, so the cross-chain hook never enforces an unproven flag. *}
            {var $mirrorEligible = $isHardBlock}
            {var $mirroredCount = count($ab['mirrors'])}
            {var $syncBadge = !$mirrorEligible
                ? ['Not mirror-eligible', 'text-fg-dim']
                : ($mirroredCount === 0
                    ? ['Eligible — pending mirror', 'text-caution-500']
                    : ($mirroredCount >= $mirrorChainsTotal
                        ? ['All chains synced', 'text-immune-500']
                        : ['Partial: ' . $mirroredCount . ' of ' . $mirrorChainsTotal . ' chains', 'text-caution-500']))}
            <section class="border border-ink-line/60 rounded-sm bg-ink-elevated/20">

                <header class="px-7 py-4 border-b border-ink-line/40 flex items-center gap-3">
                    <span class="font-mono text-[10.5px] uppercase tracking-widest2 text-fg-tertiary">Mirror status</span>
                    <span class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-widest2 {$syncBadge[1]}">
                        {if $mirroredCount > 0}
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                        {/if}
                        {$syncBadge[0]}
                    </span>
                </header>

                {if !$mirrorEligible}
                <div class="px-7 py-6">
                    <div class="flex items-center gap-2.5 mb-2">
                        <span class="inline-flex h-2 w-2 rounded-full bg-caution-500" aria-hidden="true"></span>
                        <span class="font-mono text-[11px] uppercase tracking-widest2 text-caution-500">Not eligible to mirror</span>
                    </div>
                    <p class="text-[13px] text-fg-secondary leading-[1.6] max-w-[60ch]">
                        This antibody is <span class="text-caution-500">advisory</span> — it stays on its home chain. The
                        relayer only propagates antibodies that have earned enforcement authority, so the cross-chain
                        Uniswap hook never blocks on an unproven flag. It becomes mirror-eligible once it matures to
                        hard-block:
                        <span class="text-fg-primary">{$entry->corroboration_count} of {$corroborationK}</span>
                        independent publishers corroborating so far.
                    </p>
                </div>
                {else}
                <table class="w-full">
                    <thead>
                        <tr class="border-b border-ink-line/40 bg-ink-sunken/30">
                            <th class="font-mono text-[9.5px] uppercase tracking-widest2 text-fg-tertiary font-normal text-left px-7 py-3">Chain</th>
                            <th class="font-mono text-[9.5px] uppercase tracking-widest2 text-fg-tertiary font-normal text-left px-3 py-3">Tx</th>
                            <th class="font-mono text-[9.5px] uppercase tracking-widest2 text-fg-tertiary font-normal text-right px-7 py-3">State</th>
                        </tr>
                    </thead>
                    <tbody>
                    {foreach $ab['mirrors'] as $m}
                        <tr class="border-b border-ink-line/30 last:border-0 hover:bg-ink-elevated/30 transition-colors">
                            <td class="px-7 py-3.5">
                                <div class="flex items-center gap-2.5">
                                    <span class="inline-flex h-2 w-2 rounded-full bg-immune-500" aria-hidden="true"></span>
                                    <span class="text-[13px] text-fg-primary capitalize">{$m['chain']}</span>
                                </div>
                            </td>
                            <td class="px-3 py-3.5">
                                {if $m['explorer_url']}
                                    <a href="{$m['explorer_url']}" target="_blank" rel="noopener" class="font-mono text-[11.5px] text-accent-soft hover:text-accent transition-colors inline-flex items-center gap-1">
                                        {$m['tx']}
                                        <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
                                    </a>
                                {else}
                                    <span class="font-mono text-[11.5px] text-fg-tertiary">{$m['tx']}</span>
                                {/if}
                            </td>
                            <td class="px-7 py-3.5 text-right">
                                <span class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-widest2 text-immune-500">
                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="20 6 9 17 4 12"/></svg>
                                    {$m['state']}
                                </span>
                            </td>
                        </tr>
                    {/foreach}
                    </tbody>
                </table>

                <footer class="px-7 py-3.5 border-t border-ink-line/40 font-mono text-[10.5px] text-fg-tertiary">
                    <span>{$mirroredCount} of {$mirrorChainsTotal} chains mirrored</span>
                </footer>
                {/if}

            </section>
        </div>

        {* ----------- SIDE RAIL ----------- *}
        <aside class="space-y-6">

            {* Publisher identity — ENS name + avatar, address beneath. Prefer the
             * resolved publisher record's ENS (every publisher registers a
             * *.immunity.eth subname); fall back to short hex only if unresolved. *}
            {var $pubHex = substr($ab['publisher_addr'], 2)}
            {var $pubEns = ($publisher !== null && $publisher->ens !== null) ? $publisher->ens : $entry->publisher_ens}
            {var $pubName = $pubEns ?? (substr($ab['publisher_addr'], 0, 6) . '…' . substr($ab['publisher_addr'], -4))}
            <div class="border border-ink-line/60 rounded-sm bg-ink-elevated/20 p-5">
                <div class="font-mono text-[10px] uppercase tracking-widest2 text-fg-tertiary mb-4">Publisher</div>
                <a href="/publisher/{$ab['publisher_addr']}" class="flex items-center gap-3 group" title="{$ab['publisher_addr']}">
                    <span class="h-10 w-10 rounded-full shrink-0 ring-1 ring-ink-line/50"
                          style="background: linear-gradient(135deg, #{substr($pubHex, 0, 6)}, #{substr($pubHex, -6)})"
                          aria-hidden="true"></span>
                    <span class="min-w-0 leading-tight">
                        <span class="block text-[13.5px] text-fg-primary group-hover:text-accent transition-colors truncate">{$pubName}</span>
                        <span class="block font-mono text-[10.5px] text-fg-dim truncate">{$ab['publisher_addr']}</span>
                    </span>
                </a>
            </div>

            {* Actions *}
            <div class="border border-ink-line/60 rounded-sm bg-ink-elevated/20">
                <div class="font-mono text-[10px] uppercase tracking-widest2 text-fg-tertiary px-5 py-3 border-b border-ink-line/40">Actions</div>
                <ul class="divide-y divide-ink-line/40">
                    <li>
                        {if $hasEvidenceCid}
                            <a href="{$evidenceUrl}" target="_blank" rel="noopener" download="{$entry->imm_id}.json"
                               class="flex items-center justify-between px-5 py-3 text-[13px] text-fg-secondary hover:text-fg-primary hover:bg-ink-elevated/40 transition-colors">
                                <span>View raw JSON</span>
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="text-fg-dim"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
                            </a>
                        {else}
                            <span title="no envelope uploaded yet"
                                  class="flex items-center justify-between px-5 py-3 text-[13px] text-fg-dim cursor-not-allowed select-none">
                                <span>View raw JSON</span>
                                <span class="font-mono text-[9.5px] uppercase tracking-widest2">unavailable</span>
                            </span>
                        {/if}
                    </li>
                    <li>
                        <button type="button" data-copy-cid="{$evidenceCidHex}" data-cid-available="{$hasEvidenceCid ? '1' : '0'}"
                                class="w-full flex items-center justify-between px-5 py-3 text-[13px] {$hasEvidenceCid ? 'text-fg-secondary hover:text-fg-primary hover:bg-ink-elevated/40' : 'text-fg-dim cursor-not-allowed'} transition-colors"
                                {if !$hasEvidenceCid}disabled title="no envelope uploaded yet"{/if}>
                            <span><span data-copy-cid-label>Copy evidence CID</span></span>
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="text-fg-dim"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                        </button>
                    </li>
                    <li>
                        <button type="button" data-copy-permalink
                                class="w-full flex items-center justify-between px-5 py-3 text-[13px] text-fg-secondary hover:text-fg-primary hover:bg-ink-elevated/40 transition-colors">
                            <span><span data-copy-permalink-label>Share permalink</span></span>
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="text-fg-dim"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.59 13.51l6.83 3.98M15.41 6.51l-6.82 3.98"/></svg>
                        </button>
                    </li>
                </ul>
            </div>

            {* Quick stats *}
            <div class="border border-ink-line/60 rounded-sm bg-ink-elevated/20 p-5">
                <div class="font-mono text-[10px] uppercase tracking-widest2 text-fg-tertiary mb-4">At a glance</div>
                <dl class="space-y-3">
                    <div class="flex items-baseline justify-between gap-3">
                        <dt class="text-fg-tertiary text-[11.5px]">Mirrors live</dt>
                        <dd class="font-mono text-[12px] text-fg-primary">{count($ab['mirrors'])}/{$mirrorChainsTotal}</dd>
                    </div>
                    <div class="flex items-baseline justify-between gap-3">
                        <dt class="text-fg-tertiary text-[11.5px]">Cache hits</dt>
                        <dd class="font-mono text-[12px] text-fg-primary tabular-nums">{format('decimal', $ab['impact']['cache_hits'], 0)}</dd>
                    </div>
                    <div class="flex items-baseline justify-between gap-3">
                        <dt class="text-fg-tertiary text-[11.5px]">Attacks blocked</dt>
                        <dd class="font-mono text-[12px] text-fg-primary tabular-nums">{format('decimal', $ab['impact']['blocks_made'], 0)}</dd>
                    </div>
                    {var $earnings = $ab['impact']['publisher_earnings_usdc']}
                    {var $earningsDisplay = $earnings >= 1
                        ? '$' . number_format($earnings, 2)
                        : '$' . rtrim(rtrim(number_format($earnings, 4), '0'), '.')}
                    <div class="flex items-baseline justify-between gap-3" title="80% of the 0.002 USDC fee per match, paid by the Registry contract directly to the publisher">
                        <dt class="text-fg-tertiary text-[11.5px]">Publisher earned</dt>
                        <dd class="font-mono text-[12px] {$earnings > 0 ? 'text-immune-500' : 'text-fg-dim'} tabular-nums">{$earningsDisplay}</dd>
                    </div>
                </dl>
            </div>

            {* ----------- PROTOCOL STATE ----------- *}
            {var $escrowed = (float) $entry->escrowed_fees}
            {var $prominenceLabel = match($entry->prominence_tier) {
                0 => 'standard', 1 => 'elevated', 2 => 'high', default => 'tier ' . $entry->prominence_tier,
            }}
            <div class="border border-ink-line/60 rounded-sm bg-ink-elevated/20 p-5">
                <div class="font-mono text-[10px] uppercase tracking-widest2 text-fg-tertiary mb-4">Protocol state</div>
                <dl class="space-y-3">
                    <div class="flex items-baseline justify-between gap-3" title="The {$corroborationK}-of-N rule: agents hard-block once K distinct publishers corroborate the same matcher.">
                        <dt class="text-fg-tertiary text-[11.5px]">Corroboration</dt>
                        <dd class="font-mono text-[12px] {$entry->corroboration_count >= $corroborationK ? 'text-immune-500' : 'text-fg-primary'} tabular-nums">{$entry->corroboration_count} / {$corroborationK}</dd>
                    </div>
                    <div class="flex items-baseline justify-between gap-3" title="Publisher's USDC stake bonded against this antibody.">
                        <dt class="text-fg-tertiary text-[11.5px]">Bond</dt>
                        <dd class="font-mono text-[12px] text-fg-primary tabular-nums">{format('decimal', (float) $entry->bond_amount, 2)} USDC</dd>
                    </div>
                    <div class="flex items-baseline justify-between gap-3" title="Match fees held in escrow until the antibody matures; released to the publisher on maturity, clawed back on a successful challenge.">
                        <dt class="text-fg-tertiary text-[11.5px]">Fees escrowed</dt>
                        <dd class="font-mono text-[12px] {$escrowed > 0 ? 'text-caution-500' : 'text-fg-dim'} tabular-nums">{format('decimal', $escrowed, 4)} USDC</dd>
                    </div>
                    <div class="flex items-baseline justify-between gap-3" title="Once matured the antibody is final: escrowed fees release to the publisher and the challenge window closes.">
                        <dt class="text-fg-tertiary text-[11.5px]">Maturity</dt>
                        {if $entry->isProbation()}
                            <dd class="font-mono text-[12px] text-accent">{$entry->matured_at !== null ? format('datetime', $entry->matured_at) : 'on probation'}</dd>
                        {elseif $entry->matured_at !== null}
                            <dd class="font-mono text-[12px] text-immune-500" title="{format('datetime', $entry->matured_at)}">matured</dd>
                        {else}
                            <dd class="font-mono text-[12px] text-fg-dim">—</dd>
                        {/if}
                    </div>
                    <div class="flex items-baseline justify-between gap-3" title="Prominence weighting used when ranking matches.">
                        <dt class="text-fg-tertiary text-[11.5px]">Prominence</dt>
                        <dd class="font-mono text-[12px] text-fg-secondary">{$prominenceLabel}</dd>
                    </div>
                </dl>
            </div>

            {* ----------- PUBLISHER REPUTATION ----------- *}
            {if $publisher !== null}
                {var $repTier = $publisher->reputationTier()}
                {var $repTone = match($repTier) {
                    'trusted'     => 'text-immune-500',
                    'established' => 'text-accent',
                    'emerging'    => 'text-fg-secondary',
                    default       => 'text-fg-dim',
                }}
                <div class="border border-ink-line/60 rounded-sm bg-ink-elevated/20 p-5">
                    <div class="flex items-center justify-between mb-4">
                        <div class="font-mono text-[10px] uppercase tracking-widest2 text-fg-tertiary">Publisher</div>
                        <a href="/publisher/{$ab['publisher_addr']}" class="font-mono text-[10px] uppercase tracking-widest2 text-fg-dim hover:text-accent transition-colors">Profile &rarr;</a>
                    </div>
                    <div class="mb-4">
                        <a href="/publisher/{$ab['publisher_addr']}" class="{$publisher->ens !== null ? 'text-fg-primary' : 'font-mono text-[13px] text-fg-primary'} hover:text-accent transition-colors break-all">{$ab['publisher']}</a>
                    </div>
                    <dl class="space-y-3">
                        <div class="flex items-baseline justify-between gap-3">
                            <dt class="text-fg-tertiary text-[11.5px]">Reputation</dt>
                            <dd class="font-mono text-[12px] {$repTone} tabular-nums">{format('decimal', (float) $publisher->score, 0)} <span class="text-fg-dim uppercase tracking-widest2 text-[9.5px]">{$repTier}</span></dd>
                        </div>
                        <div class="flex items-baseline justify-between gap-3">
                            <dt class="text-fg-tertiary text-[11.5px]">Matured</dt>
                            <dd class="font-mono text-[12px] text-fg-primary tabular-nums">{$publisher->matured_count}</dd>
                        </div>
                        <div class="flex items-baseline justify-between gap-3" title="Strikes from slashed antibodies or lost challenges.">
                            <dt class="text-fg-tertiary text-[11.5px]">Strikes</dt>
                            <dd class="font-mono text-[12px] {$publisher->slashed_count > 0 ? 'text-threat-500' : 'text-fg-dim'} tabular-nums">{$publisher->slashed_count}</dd>
                        </div>
                        {if (float) $publisher->genesis_granted > 0}
                            <div class="flex items-baseline justify-between gap-3" title="Genesis reputation grant at network bootstrap.">
                                <dt class="text-fg-tertiary text-[11.5px]">Genesis grant</dt>
                                <dd class="font-mono text-[12px] text-accent tabular-nums">{format('decimal', (float) $publisher->genesis_granted, 0)}</dd>
                            </div>
                        {/if}
                    </dl>
                </div>
            {/if}

        </aside>
    </div>

</section>

<script n:syntax="off">
(function () {
  function flashLabel(el, text, restore) {
    if (!el) return;
    el.textContent = text;
    setTimeout(function () { el.textContent = restore; }, 1400);
  }

  // Copy CID
  document.querySelectorAll('[data-copy-cid]').forEach(function (btn) {
    if (btn.dataset.cidAvailable !== '1') return;
    const cid = btn.dataset.copyCid;
    const label = btn.querySelector('[data-copy-cid-label]');
    btn.addEventListener('click', function () {
      navigator.clipboard.writeText(cid).then(
        function () { flashLabel(label, 'Copied', 'Copy evidence CID'); },
        function () { flashLabel(label, 'Copy failed', 'Copy evidence CID'); },
      );
    });
  });

  // Share permalink
  document.querySelectorAll('[data-copy-permalink]').forEach(function (btn) {
    const label = btn.querySelector('[data-copy-permalink-label]');
    btn.addEventListener('click', function () {
      navigator.clipboard.writeText(window.location.href).then(
        function () { flashLabel(label, 'Link copied', 'Share permalink'); },
        function () { flashLabel(label, 'Copy failed', 'Share permalink'); },
      );
    });
  });

})();
</script>

{/block}
