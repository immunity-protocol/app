APP_ENV=dev
APP_DEBUG=true
APP_TIMEZONE=UTC
# APP_CURRENCY=USD

# Security
ENCRYPTION_KEY=

# Database
DB_HOST=immunity_database
DB_PORT=5432
DB_NAME=immunity
DB_USERNAME=dev
DB_PASSWORD=dev

# Moralis API key for token-price lookups in the indexer. Optional in v1
# (without it, value_at_risk_usd stays NULL). Production: `fly secrets set`.
MORALIS_API_KEY=

# Static price overrides for tokens with no Moralis listing (mock USDC on
# Base Sepolia, demo fixtures). Keys are 0x-prefixed addresses, values are
# either a price string (decimals default to 6) or {"price":"...", "decimals":N}.
INDEXER_PRICE_OVERRIDES={"0x26265722fa5d94bB3A3C866124aDdC7b85670b16":"1.000000"}

# Base Sepolia (84532) — the live Immunity contract suite the indexer reads.
# Prefer an Alchemy key over the public endpoint for reliable eth_getLogs.
# Addresses + deploy block default to the deployed suite (see NetworkConfig);
# override only on a redeploy.
# BASE_REGISTRY_ADDRESS=
# BASE_REPUTATION_ADDRESS=
# BASE_PUBLISHER_REGISTRAR_ADDRESS=
# BASE_CHALLENGE_MANAGER_ADDRESS=
# BASE_CRE_RECEIVER_ADDRESS=
# BASE_PROTECTED_SET_ADDRESS=
# BASE_L2_REGISTRY_ADDRESS=
# BASE_USDC_ADDRESS=
# BASE_DEPLOY_BLOCK=

# Mirror chain RPCs (read by both indexer and relayer). Empty values cause
# the corresponding chain's poller / relayer to skip with a warning.
SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=

# Relayer hot wallet keys, one per chain. The wallet must be authorized on
# the destination Mirror via setRelayer(addr, true). NEVER commit a real key.
RELAYER_PRIVATE_KEY_SEPOLIA=
RELAYER_PRIVATE_KEY_BASE_SEPOLIA=

# Relayer behavior knobs (defaults shown). Bridge timeout governs how long
# the PHP wrapper waits for scripts/mirror-send.mjs per tx.
RELAYER_POLL_INTERVAL_MS=2000
RELAYER_MAX_RETRIES=5
RELAYER_BATCH_SIZE=10
RELAYER_BACKOFF_BASE_MS=5000
RELAYER_REAP_INTERVAL_SEC=60
RELAYER_REAP_STALE_SEC=300
RELAYER_BRIDGE_TIMEOUT_SEC=90
RELAYER_MEMORY_CEILING_MB=256

# Optional: override the path to config/mirror-network.json (e.g. for tests).
# MIRROR_NETWORK_FILE=

# /playground gate. PLAYGROUND_PASSWORD unlocks Section 1 + 2 (the judge
# tier shared with hackathon judges). ADMIN_PASSWORD additionally unlocks
# Section 3 (pitch controls) and the destructive admin endpoints.
PLAYGROUND_PASSWORD=
ADMIN_PASSWORD=
